void caxambinho(int xp, int yp){
  // Boné vermelho
  fill(#E30004);
  rect(160+xp, 80+yp, 180, 40);
  rect(140+xp, 120+yp, 220, 30);
  rect(190+xp, 70+yp, 120, 20);
  
  // ===== Cabelo / costeletas =====
  fill(#5A2C00);
  rect(150+xp, 150+yp, 60, 60);
  rect(310+xp, 150+yp, 60, 60);
  
  // ===== Rosto =====
  fill(#E8B159);
  rect(200+xp, 150+yp, 110, 110);
  
  // ===== Olhos =====
  fill(#050505);
  rect(230+xp, 180+yp, 20, 30);
  rect(270+xp, 180+yp, 20, 30);
  
  // Nariz
  fill(#E8B159);
  rect(310+xp, 200+yp, 30, 30);
  
  // Bigode
  fill(#5A2C00);
  rect(220+xp, 240+yp, 100, 20);
  rect(210+xp, 250+yp, 120, 15);
  
  // Camisa vermelha
  fill(#E30004);
  rect(180+xp, 260+yp, 150, 90);
  
  // Macacão azul
  fill(#0046FF);
  rect(160+xp, 300+yp, 80, 110);
  rect(270+xp, 300+yp, 80, 110);
  rect(180+xp, 300+yp, 150, 60);
  
  // Botões do macacão
  fill(#FFD700);
  rect(210+xp, 310+yp, 20, 20);
  rect(290+xp, 310+yp, 20, 20);
  
  // Braços
  fill(#E30004);
  rect(130+xp, 270+yp, 40, 80);
  rect(330+xp, 270+yp, 40, 80);
  
  // Mãos
  fill(#E8B159);
  rect(120+xp, 340+yp, 50, 40);
  rect(330+xp, 340+yp, 50, 40);
  
  // Parte inferior do macacão
  fill(#0046FF);
  rect(200+xp, 400+yp, 40, 60);
  rect(260+xp, 400+yp, 40, 60);
  
  // Sapatos
  fill(#B47205);
  rect(190+xp, 450+yp, 70, 30);
  rect(250+xp, 450+yp, 70, 30);
}
